#!/usr/bin/env bash
#BSUB -J dynsphere-l40-cpu-aggregate
#BSUB -q long
#BSUB -n 2
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8000]"
#BSUB -W 08:00
#BSUB -o logs/au-l40-cpu-aggregate-%J.out
#BSUB -e logs/au-l40-cpu-aggregate-%J.err
set -euo pipefail
module load git/2.40.0
: "${DYNSPHERE_AGGREGATION_REPO:?Set the unchanged CPU recovery checkout}"
cd "$DYNSPHERE_AGGREGATION_REPO"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1
: "${DYNSPHERE_ORIGINAL_ROOT:?Set the original GPU run directory}"
: "${DYNSPHERE_ORIGINAL_MANIFEST:?Set the original GPU manifest file}"
: "${DYNSPHERE_RECOVERY_ROOT:?Set the corrected CPU run directory}"
: "${DYNSPHERE_RECOVERY_MANIFEST:?Set the corrected CPU manifest file}"
: "${DYNSPHERE_AGGREGATION_OUTPUT:?Set a new output directory}"
exec .venv/bin/python -u -m research.submission_recovery.aggregate \
  --original-root "$DYNSPHERE_ORIGINAL_ROOT" \
  --original-manifest "$DYNSPHERE_ORIGINAL_MANIFEST" \
  --recovery-root "$DYNSPHERE_RECOVERY_ROOT" \
  --recovery-manifest "$DYNSPHERE_RECOVERY_MANIFEST" \
  --output "$DYNSPHERE_AGGREGATION_OUTPUT"
