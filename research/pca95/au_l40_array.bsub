#!/usr/bin/env bash
#BSUB -J "dynsphere-pca95-l40[1-16]%4"
#BSUB -q long
#BSUB -gpu "num=1:gmodel=NVIDIAL40"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32000]"
#BSUB -W 48:00
