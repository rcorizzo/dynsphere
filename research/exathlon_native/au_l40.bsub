#!/usr/bin/env bash
#BSUB -J "dynsphere-native-l40[1-24]%2"
#BSUB -q long
#BSUB -gpu "num=1:gmodel=NVIDIAL40"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16000]"
#BSUB -W 25:00
#BSUB -o logs/au-native-l40-%J-%I.out
#BSUB -e logs/au-native-l40-%J-%I.err

set -euo pipefail
module load git/2.40.0
: "${DYNSPHERE_NATIVE_REPO:?Set the isolated native-evaluation checkout}"
cd "$DYNSPHERE_NATIVE_REPO"
export DYNSPHERE_DEVICE=cuda OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export LOKY_MAX_CPU_COUNT=1 PYTHONUNBUFFERED=1
result_root="$DYNSPHERE_NATIVE_REPO/results/exathlon_native_frozen_20261025"
hardware="$result_root/hardware/$LSB_JOBID-$LSB_JOBINDEX"
mkdir -p "$hardware"
nvidia-smi > "$hardware/nvidia-smi.txt"
for method in catch mtad_gat; do
  "benchmarks/official_baselines/.envs/$method/bin/python" -c '
import json, torch
assert torch.cuda.is_available(), "CUDA is required"
assert "L40" in torch.cuda.get_device_name(0), "An L40 is required"
x=torch.randn(128,128,device="cuda")
assert bool(torch.isfinite(x@x).all().item())
print(json.dumps({"gpu":torch.cuda.get_device_name(0),"torch":torch.__version__,"cuda":torch.version.cuda}))
' > "$hardware/$method.json"
done
exec .venv/bin/python -m research.exathlon_native.run --output "$result_root" deep \
  --shard-index "$((LSB_JOBINDEX-1))" --shard-count 24
