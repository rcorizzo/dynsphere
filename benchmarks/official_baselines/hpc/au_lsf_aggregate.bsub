#!/usr/bin/env bash
#BSUB -J dynsphere-aggregate
#BSUB -q normal
#BSUB -n 2
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8000]"
#BSUB -W 02:00
#BSUB -o logs/au-aggregate-%J.out
#BSUB -e logs/au-aggregate-%J.err

set -euo pipefail

: "${DYNSPHERE_REPO:?Set DYNSPHERE_REPO to the repository path on Lovelace}"
PYTHON_EXECUTABLE="${DYNSPHERE_PYTHON:-$DYNSPHERE_REPO/.venv/bin/python}"
TSB_DATA_ROOT="${DYNSPHERE_TSB_DATA_ROOT:-$DYNSPHERE_REPO/benchmarks/tsb_ad_m/data/TSB-AD-M}"
RESULT_ROOT="${DYNSPHERE_RESULT_ROOT:-$DYNSPHERE_REPO/results/official_baselines_v1}"
MANIFEST="$RESULT_ROOT/campaigns/hpc-seed37-au-complete.json"
CPU_MANIFEST="$RESULT_ROOT/campaigns/hpc-seed37-au-cpu.json"
GPU_MANIFEST="$RESULT_ROOT/campaigns/hpc-seed37-au-gpu.json"
CATCH_MANIFEST="$RESULT_ROOT/campaigns/hpc-seed37-au-catch-overlap-v1.json"

cd "$DYNSPHERE_REPO"
"$PYTHON_EXECUTABLE" -m benchmarks.official_baselines.merge_campaign_manifests \
  --output "$MANIFEST" \
  "$CPU_MANIFEST" \
  "$GPU_MANIFEST" \
  "$CATCH_MANIFEST"

exec "$PYTHON_EXECUTABLE" -m benchmarks.official_baselines.aggregate_campaign \
  --campaign-manifest "$MANIFEST" \
  --result-root "$RESULT_ROOT"
