#!/usr/bin/env bash
#BSUB -J "dynsphere-extension-vus[1-16]%4"
#BSUB -q long
#BSUB -n 1
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=8000]"
#BSUB -W 24:00
#BSUB -o logs/au-extension-vus-%J-%I.out
#BSUB -e logs/au-extension-vus-%J-%I.err
set -euo pipefail
: "${DYNSPHERE_REPO:?Set DYNSPHERE_REPO to the code checkout}"
exec bash "$DYNSPHERE_REPO/benchmarks/official_baselines/hpc/run_extension_metrics.sh"
