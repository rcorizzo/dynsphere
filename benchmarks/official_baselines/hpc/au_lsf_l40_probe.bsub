#!/usr/bin/env bash
#BSUB -J dynsphere-l40-probe
#BSUB -q normal
#BSUB -gpu "num=1"
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32000]"
#BSUB -W 02:00
#BSUB -o logs/au-l40-probe-%J.out
#BSUB -e logs/au-l40-probe-%J.err

set -euo pipefail

: "${DYNSPHERE_REPO:?Set DYNSPHERE_REPO to the repository path on Lovelace}"
exec bash "$DYNSPHERE_REPO/benchmarks/official_baselines/hpc/run_au_gpu_probe.sh"
